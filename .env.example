# Copy to .env (git-ignored) and fill in YOUR OWN keys. This repo ships no keys,
# and nothing in it runs on a schedule: the desk only runs when you start it.

# ---- Required for a live run (not for `desk demo`)
ANTHROPIC_API_KEY=             # https://console.anthropic.com
FINNHUB_KEY=                   # free key at https://finnhub.io (headlines, earnings dates)

# ---- Where emails go
# Leave DESK_EMAIL_SINK set to write every email to a folder instead of sending it.
DESK_EMAIL_SINK=out/mail
# To send for real through Gmail, clear DESK_EMAIL_SINK and set these:
# DESK_EMAIL=you.desk@gmail.com
# GMAIL_APP_PASSWORD=          # a Gmail app password (needs 2-Step Verification)
# ALERT_TO=you@example.com, teammate@example.com
# AUDIT_TO=you@example.com     # the daily health check goes only here

# ---- Universe and storage
# UNIVERSE_CSV=desk/config/universe.csv   # default: the Nasdaq-100
# DESK_HOME=.desk                         # state and the Signal Log (local files)
# Optional Google Sheet backend instead of local files:
# SHEET_ID=
# GOOGLE_CREDS_JSON=           # path to a service-account JSON, or the JSON itself

# ---- Models and budgets (defaults shown)
# MODEL_ANALYST=claude-sonnet-5
# MODEL_FAST=claude-haiku-4-5-20251001
# MODEL_STRATEGIST=            # empty = MODEL_FAST
# CHARTIST_EFFORT=low
# DAILY_AI_CALLS=40            # hard stop per day, all agents
# DRY_RUN_AI_CALLS=8
# WATCHED_STRATEGISTS=Tom Lee,Mark Newton   # whose real, sourced comments to quote

# ---- Alert caps and thresholds (defaults shown)
# SHORT_ALERTS_PER_DAY=7
# LONG_ALERTS_PER_DAY=2
# VIP_ALERTS_PER_DAY=6
# EMAIL_MIN_RVOL=1.5
# DIGEST_MAX=8
# RVOL_MIN=2.5
# GAP_MIN_PCT=3.0
# BREAKOUT_DAYS=20
# NEAR_200DMA_PCT=2.0
# MIN_MINUTES_AFTER_OPEN=30

# ---- Ask the desk (replies to alert emails, over IMAP)
# ASK_DESK=on
# ASK_ALLOW=                   # extra addresses allowed to ask, besides ALERT_TO
